{
	"name": "next-bay",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "next typegen && tsc --noEmit",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck",
		"sync": "git switch main && git pull && pnpm install",
		"sync:branch": "git fetch origin && git merge --no-commit origin/main && pnpm install"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@phosphor-icons/react": "^2.1.10",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.72.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.32",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "24.x"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	}
}
